<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PCL-Unlock</AssemblyName>
    <RootNamespace>PclUnblock.Launcher</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PCL.Unblock.Hook\PCL.Unblock.Hook.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PCL.Unblock.Patcher\PCL.Unblock.Patcher.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\PCL.Unblock.Hook\bin\$(Configuration)\net10.0\PCL.Unblock.Hook.dll"
                      LogicalName="PclUnblock.Payload.PCL.Unblock.Hook.dll" />
    <EmbeddedResource Include="..\PCL.Unblock.Patcher\bin\$(Configuration)\net10.0\PCL.Unblock.Patcher.dll"
                      LogicalName="PclUnblock.Payload.PCL.Unblock.Patcher.dll" />
    <EmbeddedResource Include="..\PCL.Unblock.Patcher\bin\$(Configuration)\net10.0\0Harmony.dll"
                      LogicalName="PclUnblock.Payload.0Harmony.dll" />
    <EmbeddedResource Include="..\THIRD-PARTY-NOTICES.txt"
                      LogicalName="PclUnblock.ThirdPartyNotices.txt" />
  </ItemGroup>
</Project>
